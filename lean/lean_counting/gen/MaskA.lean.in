import QECCountComp.KernA
import QECCountComp.Data.@NAME@

/-!
# Exclusion hints of the augmented certificate @NAME@ (untrusted generator, run with compiled evaluation)

For the near entries `LO ≤ i < HI` (`KIND = near`) or the bulk entries (`KIND = bulk`) of @NAME@: the mask of the
candidate steps whose listed successor is excluded by `exclWinAK` (the kernel route's own search and check), one line
per entry; bulk lines pack the masks at the head heights `bigH` and `HC` as `m₀ + 256 m₁`. Written to `OUT`. The
kernel checks every claimed exclusion again, so these hints need not be trusted.
-/

open QECComp QECComp.Data

def maskAtA (P : ParamsA) (nk nG bk bH : Array Nat) (s : List (Nat × Bool)) (h : Int) : Nat :=
  ((candList 2).zip (List.range 8)).foldl (fun m xi =>
    let u := s ++ [xi.1]
    let h2 := h - dl2 xi.1.1
    if !selfAvoid 2 u || decide (h2 < 0) then m
    else match potA P nk nG bk bH u.tail h2 with
      | some _ => if exclWinAK P (h + vdisp s) u then m + 2 ^ xi.2 else m
      | none => m) 0

def maskLine (kind : String) (i : Nat) : Nat :=
  let P := P@NAME@
  if kind == "near" then
    let k := nk@NAME@[i]!
    maskAtA P nk@NAME@ nG@NAME@ bk@NAME@ bH@NAME@ (decodeA P.K k) ((heightOf P.K k : Nat) : Int)
  else
    let s := decodeA P.K bk@NAME@[i]!
    maskAtA P nk@NAME@ nG@NAME@ bk@NAME@ bH@NAME@ s bigH +
      256 * maskAtA P nk@NAME@ nG@NAME@ bk@NAME@ bH@NAME@ s P.HC

def runMasks : IO Unit := do
  let kind := (← IO.getEnv "KIND").getD "near"
  let lo := ((← IO.getEnv "LO").getD "0").toNat!
  let hi0 := ((← IO.getEnv "HI").getD "0").toNat!
  let out := (← IO.getEnv "OUT").getD "masks.txt"
  let n := if kind == "near" then nk@NAME@.size else bk@NAME@.size
  let hi := min hi0 n
  let ls := (List.range' lo (hi - lo)).map (fun i => toString (maskLine kind i))
  IO.FS.writeFile out (String.intercalate "\n" ls ++ "\n")
  IO.println s!"{kind} {lo} {hi} of {n}"

#eval runMasks
