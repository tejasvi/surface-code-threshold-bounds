theorem hdfs : dfsOKK PA6K tA6K PA6K.K [] = true := by
  apply dfsOKK_of_tops (by decide)
  have hl : (candList PA6K.n).length = 8 := by decide
  rw [hl]
  intro j hj
  interval_cases j
  exacts [dfs0, dfs1, dfs2, dfs3, dfs4, dfs5, dfs6, dfs7]

/-- The bound of certificate A6K (kernel route) for every box with `K + 1 ≤ N a` and `0 < p ≤ 11/250`. -/
theorem bound (N : Fin PA6K.n → ℕ) (a : Fin PA6K.n) (hK : PA6K.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((11 : ℕ) : ℝ) / (250 : ℕ)) :
    PfailMW (boxEdges PA6K.n N a) p ≤
      #(univ.filter (fun u : BoxV PA6K.n N => (u a : ℕ) = 0)) * ((PA6K.K0n : ℝ) / PA6K.K0d) *
        ((PA6K.lamN : ℝ) / PA6K.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) ^ (N a - 1 - PA6K.K) /
          (1 - (PA6K.lamN : ℝ) / PA6K.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) :=
  box_bound_of_certK PA6K tA6K N a 11 250 3266619 1000000 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs start hK hp0 hp

