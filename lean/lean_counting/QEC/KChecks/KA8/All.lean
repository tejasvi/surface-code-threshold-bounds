/-- The bound of certificate KA8 (kernel route) for every box with `K + 1 ≤ N a` and `0 < p ≤ 9/200`. -/
theorem bound (N : Fin PKA8.n → ℕ) (a : Fin PKA8.n) (hK : PKA8.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((9 : ℕ) : ℝ) / (200 : ℕ)) :
    PfailMW (boxEdges PKA8.n N a) p ≤
      #(univ.filter (fun u : BoxV PKA8.n N => (u a : ℕ) = 0)) * ((PKA8.K0n : ℝ) / PKA8.K0d) *
        ((PKA8.lamN : ℝ) / PKA8.lamD * rhoOf (((9 : ℕ) : ℝ) / (200 : ℕ)) p) ^ (N a - 1 - PKA8.K) /
          (1 - (PKA8.lamN : ℝ) / PKA8.lamD * rhoOf (((9 : ℕ) : ℝ) / (200 : ℕ)) p) :=
  box_bound_of_certK PKA8 tKA8 N a 9 200 31766 10000 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs start hK hp0 hp

