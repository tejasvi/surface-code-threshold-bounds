      #(univ.filter (fun u : BoxV PD2K6.n N => (u a : ℕ) = 0)) * ((PD2K6.K0n : ℝ) / PD2K6.K0d) *
        ((PD2K6.lamN : ℝ) / PD2K6.lamD * rhoOf (((31 : ℕ) : ℝ) / (2000 : ℕ)) p) ^ (N a - 1 - PD2K6.K) /
          (1 - (PD2K6.lamN : ℝ) / PD2K6.lamD * rhoOf (((31 : ℕ) : ℝ) / (2000 : ℕ)) p) :=
  box_bound_of_certK PD2K6 tD2K6 N a 31 2000 49 10 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
