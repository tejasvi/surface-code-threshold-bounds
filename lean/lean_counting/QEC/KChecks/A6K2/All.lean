theorem hrows : ∀ e ∈ tA6K2.toList, rowCheckK PA6K2 tA6K2 e = true :=
  allE_iff.mp (show KTree.allE (rowCheckK PA6K2 tA6K2) A6K2.u14 = true from arows14)

theorem hst : startOKK PA6K2 tA6K2 = true := by
  apply startOKK_of_totK
  rw [show tA6K2 = A6K2.u14 from rfl, atot14]
  decide +kernel

theorem hdfs : dfsOKK PA6K2 tA6K2 PA6K2.K [] = true := by
  apply dfsOKK_of_prefixes (d := 1) (by decide)
  intro js hlen hjs
  have hl : (candList PA6K2.n).length = 8 := by decide
  rw [hl] at hjs
  match js, hlen with
  | [j1], _ =>
    have hj1 : j1 < 8 := hjs j1 (by simp)
    interval_cases j1
    exacts [dfsp_0, dfsp_1, dfsp_2, dfsp_3, dfsp_4, dfsp_5, dfsp_6, dfsp_7]

/-- The bound of certificate A6K2 (kernel route) for every box with `K + 1 ≤ N a` and `0 < p ≤ 11/250`. -/
theorem bound (N : Fin PA6K2.n → ℕ) (a : Fin PA6K2.n) (hK : PA6K2.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((11 : ℕ) : ℝ) / (250 : ℕ)) :
    PfailMW (boxEdges PA6K2.n N a) p ≤
      #(univ.filter (fun u : BoxV PA6K2.n N => (u a : ℕ) = 0)) * ((PA6K2.K0n : ℝ) / PA6K2.K0d) *
        ((PA6K2.lamN : ℝ) / PA6K2.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) ^ (N a - 1 - PA6K2.K) /
          (1 - (PA6K2.lamN : ℝ) / PA6K2.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) :=
  box_bound_of_certK PA6K2 tA6K2 N a 11 250 3266619 1000000 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs hst hK hp0 hp

