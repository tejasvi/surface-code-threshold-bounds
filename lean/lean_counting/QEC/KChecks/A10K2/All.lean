/-- The bound of certificate A10K2 (kernel route) for every box with `K + 1 ≤ N a` and `0 < p ≤ 93/2000`. -/
theorem bound (N : Fin PA10K2.n → ℕ) (a : Fin PA10K2.n) (hK : PA10K2.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((93 : ℕ) : ℝ) / (2000 : ℕ)) :
    PfailMW (boxEdges PA10K2.n N a) p ≤
      #(univ.filter (fun u : BoxV PA10K2.n N => (u a : ℕ) = 0)) * ((PA10K2.K0n : ℝ) / PA10K2.K0d) *
        ((PA10K2.lamN : ℝ) / PA10K2.lamD * rhoOf (((93 : ℕ) : ℝ) / (2000 : ℕ)) p) ^ (N a - 1 - PA10K2.K) /
          (1 - (PA10K2.lamN : ℝ) / PA10K2.lamD * rhoOf (((93 : ℕ) : ℝ) / (2000 : ℕ)) p) :=
  box_bound_of_certK PA10K2 tA10K2 N a 93 2000 3091 1000 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs hst hK hp0 hp

end QECKChecks.A10K2
