/-!
# Certificate A6: assembly of the native checks (generated by gen/mkall.py)
-/

namespace QECChecks.A6

open QEC QECComp QECComp.Data Finset

theorem hrows : ∀ i < keysA6.size, rowCheck PA6 keysA6 HsA6 i = true := by
  rw [size]
  have h0 := rows0
  have h1 := rowsOK_append (by decide) (by decide) h0 rows1
  have h2 := rowsOK_append (by decide) (by decide) h1 rows2
  have h3 := rowsOK_append (by decide) (by decide) h2 rows3
  exact rowCheck_of_rowsOK h3

theorem hdfs : dfsOK PA6 keysA6 PA6.K [] = true := by
  apply dfsOK_of_tops (by decide)
  have hl : (candList PA6.n).length = 8 := by decide
  rw [hl]
  intro j hj
  interval_cases j
  exacts [dfs0, dfs1, dfs2, dfs3, dfs4, dfs5, dfs6, dfs7]

/-- The bound of certificate A6 for every box with `K + 1 ≤ N a` and every `0 < p ≤ 11/250`. -/
theorem bound (N : Fin PA6.n → ℕ) (a : Fin PA6.n) (hK : PA6.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((11 : ℕ) : ℝ) / (250 : ℕ)) :
    PfailMW (boxEdges PA6.n N a) p ≤
      #(univ.filter (fun u : BoxV PA6.n N => (u a : ℕ) = 0)) * ((PA6.K0n : ℝ) / PA6.K0d) *
        ((PA6.lamN : ℝ) / PA6.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) ^ (N a - 1 - PA6.K) /
          (1 - (PA6.lamN : ℝ) / PA6.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) :=
  box_bound_of_cert PA6 keysA6 HsA6 N a 11 250 3266619 1000000 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs start hK hp0 hp

end QECChecks.A6
