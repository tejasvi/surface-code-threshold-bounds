theorem hdfs : dfsOK PD2 keysD2 PD2.K [] = true := by
  apply dfsOK_of_tops (by decide)
  have hl : (candList PD2.n).length = 12 := by decide
  rw [hl]
  intro j hj
  interval_cases j
  exacts [dfs0, dfs1, dfs2, dfs3, dfs4, dfs5, dfs6, dfs7, dfs8, dfs9, dfs10, dfs11]

/-- The bound of certificate D2 for every box with `K + 1 ≤ N a` and every `0 < p ≤ 2/125`. -/
theorem bound (N : Fin PD2.n → ℕ) (a : Fin PD2.n) (hK : PD2.K + 1 ≤ N a) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((2 : ℕ) : ℝ) / (125 : ℕ)) :
    PfailMW (boxEdges PD2.n N a) p ≤
      #(univ.filter (fun u : BoxV PD2.n N => (u a : ℕ) = 0)) * ((PD2.K0n : ℝ) / PD2.K0d) *
        ((PD2.lamN : ℝ) / PD2.lamD * rhoOf (((2 : ℕ) : ℝ) / (125 : ℕ)) p) ^ (N a - 1 - PD2.K) /
          (1 - (PD2.lamN : ℝ) / PD2.lamD * rhoOf (((2 : ℕ) : ℝ) / (125 : ℕ)) p) :=
  box_bound_of_cert PD2 keysD2 HsD2 N a 2 125 231 50 rfl rfl rfl (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (by decide) (by decide) (by decide) (by decide) hrows hdfs start hK hp0 hp

