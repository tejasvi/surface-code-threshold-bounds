theorem hdfs : dfsOKS PS10 keysS10 PS10.K [] = true := by
  apply dfsOKS_of_tops (by decide)
  have hl : (candList PS10.n).length = 8 := by decide
  rw [hl]
  intro j hj
  interval_cases j
  exacts [dfs0, dfs1, dfs2, dfs3, dfs4, dfs5, dfs6, dfs7]

/-- The bound of certificate S10 for the rotated code of every odd distance `d ≥ K + 2` and `0 < p ≤ 11/250`. -/
theorem bound (d : ℕ) (hd3 : 3 ≤ d) (hodd : Odd d) (hK : PS10.K + 2 ≤ d) {p : ℝ} (hp0 : 0 < p)
    (hp : p ≤ ((11 : ℕ) : ℝ) / (250 : ℕ)) :
    PfailRot d p ≤
      2 * d * ((PS10.K0n : ℝ) / PS10.K0d) *
        ((PS10.lamN : ℝ) / PS10.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) ^ (d - 2 - PS10.K) /
          (1 - (PS10.lamN : ℝ) / PS10.lamD * rhoOf (((11 : ℕ) : ℝ) / (250 : ℕ)) p) :=
  rot_bound_of_certS PS10 keysS10 HsS10 rfl d hd3 hodd 11 250 671 200 rfl rfl rfl (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) (by decide) (by decide) (by decide) hrows hdfs start hK hp0 hp

