import QECD1.Walks
import QECD1.CertTab

/-!
# The witness walk counts `N_c(z)` from a table

`NcT c z` reads `N_c(z)` from the table `ncTab` (generated by a script) for `|z| ≤ 16 + 8c` and is
`4184^c` beyond: there every `c`-step walk ends at `|z + w| ≥ 17`. `Ncnt_eq_NcT`: for `c ≤ 4` the 1D count `Ncnt c z`
of `QECD1.Walks` (equal to the 3D walk count, `walkSum_eq`) is `NcT c z` for every `z`. The proof is an induction
over `c`: each table row is the convolution of the previous one (`ncT_step`, kernel check), and far from `0` both
sides are `4184^c`.
-/

namespace QECD1

open QECD1.Tab

/-- The witness walk counts read from the table. -/
def NcT (c : ℕ) (z : ℤ) : ℕ :=
  if z.natAbs ≤ 16 + 8 * c then (ncTab.getD c #[]).getD (z + 16 + 8 * c).toNat 0 else 4184 ^ c

theorem stepCount_sum : ∑ k ∈ Finset.Icc (-8 : ℤ) 8, stepCount k = 4184 := by decide +kernel

theorem ncT_zero_small : ∀ z ∈ Finset.Icc (-16 : ℤ) 16, NcT 0 z = 0 := by decide +kernel

/-- Each table row is the convolution of the previous one with the fibre sizes. -/
theorem ncT_step : ∀ c : ℕ, c < 4 → ∀ z ∈ Finset.Icc (-(24 + 8 * (c : ℤ))) (24 + 8 * (c : ℤ)),
    ∑ k ∈ Finset.Icc (-8 : ℤ) 8, stepCount k * NcT c (z + k) = NcT (c + 1) z := by decide +kernel

/-- **The table is exact.** -/
theorem Ncnt_eq_NcT : ∀ c ≤ 4, ∀ z, Ncnt c z = NcT c z := by
  intro c
  induction c with
  | zero =>
    intro _ z
    simp only [Ncnt]
    by_cases hz : z.natAbs ≤ 16
    · rw [ncT_zero_small z (by rw [Finset.mem_Icc]; omega), if_neg (by omega)]
    · rw [if_pos (by omega)]
      unfold NcT
      rw [if_neg (by omega), pow_zero]
  | succ c ih =>
    intro hc z
    have ih' := ih (by omega)
    simp only [Ncnt]
    rw [Finset.sum_congr rfl fun k _ => by rw [ih' (z + k)]]
    by_cases hz : z.natAbs ≤ 24 + 8 * c
    · exact ncT_step c (by omega) z (by rw [Finset.mem_Icc]; omega)
    · have hfar : ∀ k ∈ Finset.Icc (-8 : ℤ) 8, NcT c (z + k) = 4184 ^ c := by
        intro k hk
        rw [Finset.mem_Icc] at hk
        unfold NcT
        rw [if_neg (by omega)]
      rw [Finset.sum_congr rfl fun k hk => by rw [hfar k hk], ← Finset.sum_mul, stepCount_sum]
      unfold NcT
      rw [if_neg (by omega), pow_succ]
      ring

end QECD1
